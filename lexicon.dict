;;; -*- mode: lisp; base: 10; syntax: common-lisp; -*-
;;; lexicon.dict -- parser vocabulary for THIS domain.
;;;
;;; Loaded automatically alongside concept-types.lisp and relation-types.lisp
;;; when the domain is mounted (cg-from-parse `ensure-domain-lexicon'). Read in
;;; the :parsifal package with Marcus's dictionary and supplement.dict already
;;; in place, so `jlike' targets from either resolve.
;;;
;;; Every content word here wants a same-named concept type in
;;; concept-types.lisp -- they are paired by NAME. `cfp:validate-lexicon'
;;; reports the ones that are not.
;;;
;;;   `jlike NEW OLD'  clone OLD's features/markers/case frame -- the cheapest
;;;                    entry, right for an ordinary noun.
;;;   `df'             define from scratch; needed for anything with a case
;;;                    frame (a verb) or its own feature set (a proper noun).

;; --- verbs ---
;; DRIVE's canonical graph in concept-types.lisp is
;;   [DRIVE]- (agnt)→[PERSON] (dest)→[PLACE] (inst)→[VEHICLE] (obj)→[PERSON]
;; -- the vehicle is the INSTRUMENT, `obj' the person driven. The frame gets
;; both from the one direct-object position:
;;   (*obj ins)    the object may fill `ins' as well as the first open case,
;;                 `neut' -- Marcus's mechanism for give's (*obj dat)
;;   neut (# hanim #)  ...and the markers choose: drive's `neut' takes only
;;                 humans, `ins' (its markerset) only the inanimate. So
;;                 "drove Sue" is (obj)→[PERSON: Sue], "drove a car"
;;                 (inst)→[CAR].
;;   (neut) (ins)  both optional, or whichever the object did not fill is an
;;                 obligatory slot left empty -- "drove Sue" lost Sue outright.
;; cg-from-parse maps `ins' to `inst' and `neut' to `obj'.
;; Modelled on Marcus's `go' for the rest: cf (nil (pfrom) (pto) agt) -- the
;; origin (pfrom, "from Baltimore") extracts as (src), the destination (pto,
;; "to Boston") as (dest). Without pfrom here, "from Baltimore to Boston"
;; fitted no frame and both places were lost.

(df drive feats (mainverb pres tnsless v-3s)
     cf ((*obj ins) (neut) (ins) (pfrom) (pto) agt)
     neut (# hanim #)
     markers act)
(df drove  irreg (drive (past vspl) (tnsless v-3s pres)))
(df driven irreg (drive (en) (tnsless v-3s pres)))



;; --- nouns ---
(jlike automobile block)   ; inanimate physobj count noun ("...drive his automobile")
(jlike car block)          ; another name for AUTOMOBILE (an alias in concept-types.lisp)
(jlike greg mitch)


;; --- place names ---
;; Modelled on Marcus's `chicago': (noun ns n3p propnoun place), markers (place).
;; The `place' marker is what lets a locative/directional PP fill its case, and
;; it is what makes the name a place: "to Boston" is (dest)->[PLACE: Boston].
;; A feature that names a kind of PLACE in concept-types.lisp says what kind:
;; `city' below makes [CITY: Baltimore]. (Person names work the same way, from
;; PERSON: a `woman' feature on a name gives [WOMAN: Sue].)
(df baltimore feats (noun ns n3p propnoun city) markers (place))
(df miami feats (noun ns n3p propnoun city) markers (place))
(df maryland feats (noun ns n3p propnoun us-state) markers (place))
(df france feats (noun ns n3p propnoun country) markers (place))
